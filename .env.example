# =============================================================================
# Neuro Specialities AI service — local .env template
# =============================================================================
#
# Copy this file to `backend/.env` and fill in real values.
# `backend/.env` is gitignored — never commit real keys.
#
# This .env is used ONLY by the local Python service (`uv run ...`).
# On Vercel, do NOT upload this file. Configure the same variables through
# the Vercel dashboard (Settings → Environment Variables).
# =============================================================================

# Required. At least one Groq key.
GROQ_API_KEY_1=

# Optional fallback keys. Used only when earlier keys hit a retryable
# failure (rate limit, temporary provider error, timeout).
GROQ_API_KEY_2=
GROQ_API_KEY_3=